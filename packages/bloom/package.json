{
  "name": "@koaris/bloom-ui",
  "version": "2.2.0",
  "description": "Bloom-ui is a public design system from the Koaris Project developed with React, Typescript, and Tailwind.",
  "source": "./src/index.ts",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "build": "NODE_ENV=production npx tailwindcss -i ./src/styles/tailwind.css -o ./tailwind.css -c ./tailwind.config.ts  --minify && tsup",
    "dev": "concurrently --kill-others \"npx tailwindcss -i ./src/styles/tailwind.css -o ./tailwind.css -c ./tailwind.config.ts  --minify --watch \" \"tsup --watch\"",
    "lint": "eslint src --fix",
    "lint:ci": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "design-system",
    "react"
  ],
  "files": [
    "dist",
    "README.md",
    "tailwind.css"
  ],
  "author": "guilhermesalviano",
  "homepage": "https://koaris.github.io/bloom-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koaris/bloom-ui.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@koaris/eslint-config": "*",
    "@koaris/tokens": "*",
    "@koaris/ts-config": "*",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "concurrently": "^9.2.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
