{
    "$schema": "https://turborepo.org/schema.json",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "outputs": [
                "dist/**",
                "tailwind.css",
                "storybook-static/**",
                "docs-build/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "test": {
            "dependsOn": [
                "build"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        }
    }
}
